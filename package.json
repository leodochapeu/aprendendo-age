{
  "name": "aprendendo-age",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:generate-battle-results": "tsx --tsconfig tsconfig.app.json scripts/generate-unit-battle-results.ts",
    "data:extract-unidades": "python scripts/extract-unidades-aom.py",
    "data:extract-unit-models": "python scripts/extract-unit-models-aom.py",
    "data:merge-unidades": "python scripts/merge-unidades-aom.py",
    "data:fill-unidades-descricoes": "python scripts/fill-unidades-descricoes.py",
    "data:import-unit-ability-icons": "python scripts/import-unit-ability-icons.py",
    "data:extract-tecnologias": "python scripts/extract-tecnologias-aom.py",
    "data:merge-tecnologias": "python scripts/merge-tecnologias-aom.py",
    "data:fill-tecnologias-descricoes": "python scripts/fill-tecnologias-descricoes.py",
    "data:extract-godpowers": "python scripts/extract-godpowers-aom.py",
    "data:merge-godpowers": "python scripts/merge-godpowers-aom.py",
    "data:extract-construcoes": "python scripts/extract-construcoes-aom.py",
    "data:merge-construcoes": "python scripts/merge-construcoes-aom.py",
    "data:fill-construcoes-descricoes": "python scripts/fill-construcoes-descricoes.py",
    "data:extract-relics": "python scripts/extract-relics-aom.py",
    "data:merge-relics": "python scripts/merge-relics-aom.py",
    "data:extract-mapas": "python scripts/extract-mapas-aom.py",
    "data:merge-mapas": "python scripts/merge-mapas-aom.py",
    "data:fill-mapas-descricoes": "python scripts/fill-mapas-descricoes.py",
    "data:extract-music": "python scripts/extract-music-aom.py",
    "data:extract-aldeoes": "python scripts/extract-aldeoes-aom.py",
    "data:merge-aldeoes": "python scripts/merge-aldeoes-aom.py",
    "data:sync-aom": "python scripts/sync-aom-data.py",
    "assets:convert-webp": "python scripts/convert-assets-to-webp.py --write --delete-originals",
    "assets:convert-webp:dry-run": "python scripts/convert-assets-to-webp.py --dry-run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "google-translate-api-x": "^10.7.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10"
  }
}
